# Application Settings
DEBUG=True

# Database
DATABASE_URL=sqlite:///./data/merch_trends.db

# Reddit API (Free Tier)
# Get credentials from https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_client_id
REDDIT_CLIENT_SECRET=your_client_secret
REDDIT_USER_AGENT=MerchTrendEngine/1.0

# Scraping Settings
SCRAPE_DELAY_SECONDS=2
MAX_PAGES_PER_SOURCE=10

# NLP Settings
SPACY_MODEL=en_core_web_sm
MIN_PHRASE_LENGTH=2
MAX_PHRASE_LENGTH=6

# Trend Scoring Weights (must sum to 1.0)
WEIGHT_VELOCITY=0.30
WEIGHT_NOVELTY=0.25
WEIGHT_SATURATION=0.25
WEIGHT_CROSS_PLATFORM=0.10
WEIGHT_LENGTH=0.10

# Trademark Safety
FUZZY_MATCH_THRESHOLD=85
